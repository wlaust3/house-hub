# systemd unit for House Hub on pi5-server. See docs/HOSTING.md.
# Install (first deploy only): sudo cp deploy/house-hub.service /etc/systemd/system/ && sudo systemctl daemon-reload && sudo systemctl enable --now house-hub
[Unit]
Description=House Hub
After=network-online.target
Wants=network-online.target

[Service]
User=wlaust3
WorkingDirectory=/opt/apps/house-hub
# HOST, PORT, TZ and (for outside access) PUBLIC_PORT, CF_ACCESS_TEAM, CF_ACCESS_AUD. Mode 600, never committed.
EnvironmentFile=/opt/apps/house-hub/.env
ExecStart=/usr/bin/node server/index.js
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
