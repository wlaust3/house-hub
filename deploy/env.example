# Copy to /opt/apps/house-hub/.env on pi5-server (chmod 600). See docs/HOSTING.md.
TZ=America/New_York
# The dashboard, reached through Caddy at http://house.lan. Keep it on 127.0.0.1.
HOST=127.0.0.1
PORT=3222
# Outside access through a Cloudflare Tunnel (optional). Leave both CF_ values unset to keep it off.
PUBLIC_PORT=3223
#CF_ACCESS_TEAM=yourteam.cloudflareaccess.com
#CF_ACCESS_AUD=paste-the-application-audience-tag-here
# Google Calendar (optional): an OAuth client from Google Cloud. Leave unset to keep it off.
#GOOGLE_CLIENT_ID=1234-abc.apps.googleusercontent.com
#GOOGLE_CLIENT_SECRET=paste-the-client-secret-here
