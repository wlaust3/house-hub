{
  "name": "house-hub",
  "version": "0.0.1",
  "private": true,
  "description": "Locally-hosted (LAN-only) house manager app for a housekeeper and family.",
  "license": "MIT",
  "type": "module",
  "engines": { "node": ">=20" },
  "scripts": {
    "build": "tsc -p . && vite build --config web/vite.config.ts",
    "start": "npm run build --silent && node server/index.js",
    "start:server": "node server/index.js",
    "dev:web": "vite --config web/vite.config.ts",
    "dev:server": "node --watch server/index.js",
    "test": "node --test test/"
  },
  "dependencies": {
    "better-sqlite3": "^11.5.0",
    "express": "^4.21.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^5.6.3",
    "vite": "^5.4.10"
  }
}
